{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Read(./venv/**)",
      "Read(./.env)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(rm:*)"
    ]
  }
}